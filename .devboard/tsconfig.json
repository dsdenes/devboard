{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.d.ts",
    "client/**/*.svelte",
    "server/**/*.ts",
    "issues/**/*.ts",
    "vite.config.ts"
  ]
}
