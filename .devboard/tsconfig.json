{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.d.ts",
    "client/**/*.svelte",
    "lib/endpoints.ts",
    "lib/goal-proposals.ts",
    "lib/dependencies.ts",
    "lib/issue-labels.ts",
    "vite.config.ts",
    "lib/agent-registry.ts",
    "lib/provider-catalog.ts"
  ]
}
