#!/bin/sh
# Devboard's pre-push gate: reject a push that would make a commit with a
# non-Conventional subject reachable. Installed by `devboard hooks install`
# into the repository's shared hooks directory, so every worktree is gated
# without a per-worktree step.
#
# The checked-in `devboard gate-prepush` implementation decides which commits
# are new; this hook only locates it. A worktree created from an older commit
# still uses the repository's gate. Never bypass it with `git push --no-verify`:
# reword the commits instead.
set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

gate=
for candidate in \
  "$root/.devboard/target/release/devboard" \
  "$root/.devboard/target/debug/devboard"
do
  if [ -x "$candidate" ]; then
    gate=$candidate
    break
  fi
done

if [ -z "$gate" ]; then
  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        worktree=${line#worktree }
        for candidate in \
          "$worktree/.devboard/target/release/devboard" \
          "$worktree/.devboard/target/debug/devboard"
        do
          if [ -x "$candidate" ]; then
            gate=$candidate
            break
          fi
        done
        if [ -n "$gate" ]; then
          break
        fi
        ;;
    esac
  done <<EOF
$(git worktree list --porcelain)
EOF
fi

if [ -z "$gate" ] && command -v devboard >/dev/null 2>&1; then
  gate=$(command -v devboard)
fi

[ -n "$gate" ] || exit 0
exec "$gate" gate-prepush
