{
  "name": "@dsdenes/devboard",
  "version": "0.1.0",
  "type": "module",
  "description": "Devboard harness: ADR dashboard server, client, prompts, wrappers, and installer.",
  "scripts": {
    "build": "vite build && bun scripts/embed-client.mjs",
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
