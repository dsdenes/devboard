{
  "name": "@dsdenes/devboard-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Devboard harness: ADR dashboard server, client bundle, prompts, and omp wrappers.",
  "scripts": {
    "build": "vite build",
    "start": "bun run server/index.ts",
    "publish": "bun run scripts/publish.ts",
    "release": "bun run scripts/release.ts",
    "test": "bun test",
    "verify:install": "bun run scripts/verify-install.ts",
    "verify:update": "bun run scripts/verify-update.ts",
    "verify:ui": "bun run scripts/verify-ui.ts",
    "watchdog": "bun run watchdog/main.ts",
    "watchdog:install": "bun run watchdog/install.ts",
    "watchdog:uninstall": "bun run watchdog/uninstall.ts"
  },
  "files": [
    "package.json",
    "AGENTS.md",
    "README.md",
    "install.sh",
    "templates/",
    "server/",
    "client/",
    "lib/",
    "watchdog/",
    "prompts/",
    "omp/",
    "extensions/",
    "dist/",
    "index.html",
    "vite.config.ts",
    "svelte.config.js",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.3",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  }
}
