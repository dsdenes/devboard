{
  "name": "@dsdenes/devboard-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Devboard harness: ADR dashboard server, client bundle, prompts, and omp wrappers.",
  "scripts": {
    "build": "vite build",
    "start": "bun run server/index.ts",
    "publish": "bun run scripts/publish.ts",
    "release": "bun run scripts/release.ts",
    "test": "bun test",
    "verify:install": "bun run scripts/verify-install.ts",
    "verify:update": "bun run scripts/verify-update.ts",
    "verify:ui": "bun run scripts/verify-ui.ts",
    "verify:watchdog": "bun run scripts/verify-watchdog.ts",
    "verify:watchdog-live": "bun run scripts/verify-watchdog-live.ts",
    "watchdog": "bun run watchdog/main.ts",
    "watchdog:install": "bun run watchdog/install.ts",
    "watchdog:uninstall": "bun run watchdog/uninstall.ts",
    "cleanup": "bun run watchdog/cleanup-main.ts",
    "orchestrator": "bun run orchestrator/main.ts",
    "orchestrator:install": "bun run orchestrator/install.ts",
    "orchestrator:uninstall": "bun run orchestrator/uninstall.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify:interface": "bun run scripts/verify-interface.ts",
    "verify:orchestrator": "bun run scripts/verify-orchestrator.ts"
  },
  "files": [
    "package.json",
    "AGENTS.md",
    "README.md",
    "install.sh",
    "templates/",
    "server/",
    "client/",
    "lib/",
    "watchdog/",
    "orchestrator/",
    "prompts/",
    "omp/",
    "extensions/",
    "dist/",
    "index.html",
    "vite.config.ts",
    "svelte.config.js",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/svelte": "10.6.4",
    "@storybook/svelte-vite": "10.6.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.3.1",
    "@tanstack/table-core": "^9.3.1",
    "@types/bun": "^1.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "monaco-editor": "^0.57.0",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.7.1",
    "storybook": "10.6.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  }
}
